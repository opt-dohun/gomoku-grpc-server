<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 오목 게임</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark mb-3">
            <div class="container">
                <a class="navbar-brand" href="/">🎮 gRPC 오목 게임</a>
                <div class="navbar-nav ms-auto align-items-center">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="navbar-text text-light me-3">@User.Identity.Name</span>
                        <a class="nav-link text-light me-2" asp-page="/Account/EnableAuthenticator">2차 인증</a>
                        <form method="post" asp-page="/Account/Logout"><button class="btn btn-outline-light btn-sm" type="submit">로그아웃</button></form>
                    }
                    else
                    {
                        <a class="nav-link text-light me-2" asp-page="/Account/Login">로그인</a>
                        <a class="nav-link text-light" asp-page="/Account/Register">회원가입</a>
                    }
                </div>
            </div>
        </nav>
    </header>
    
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
    
    <footer class="border-top footer text-muted">
        <div class="container text-center">
            &copy; 2024 - gRPC 오목 게임 - <a href="/">홈으로</a>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>