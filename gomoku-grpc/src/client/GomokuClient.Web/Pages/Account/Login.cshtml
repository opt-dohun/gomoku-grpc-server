@page
@model GomokuClient.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "로그인";
}
<div class="container py-4"><div class="card mx-auto" style="max-width:520px"><div class="card-body">
    <h1 class="h3">로그인</h1>
    <form method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <label asp-for="Input.Email" class="form-label">이메일</label>
        <input asp-for="Input.Email" class="form-control" autocomplete="username" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
        <label asp-for="Input.Password" class="form-label mt-3">비밀번호</label>
        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>
        <div class="form-check mt-3"><input asp-for="Input.RememberMe" class="form-check-input" /><label asp-for="Input.RememberMe" class="form-check-label">로그인 유지</label></div>
        <button class="btn btn-primary w-100 mt-3" type="submit">로그인</button>
    </form>
    <p class="mt-3 mb-0"><a asp-page="/Account/Register">계정 만들기</a></p>
</div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
