@page
@model GomokuClient.Web.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "회원가입";
}
<div class="container py-4"><div class="card mx-auto" style="max-width:520px"><div class="card-body">
    <h1 class="h3">계정 만들기</h1>
    <p>가입 후 인증 앱으로 QR 코드를 등록해야 게임을 이용할 수 있습니다.</p>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <label asp-for="Input.Email" class="form-label">이메일</label>
        <input asp-for="Input.Email" class="form-control" autocomplete="username" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
        <label asp-for="Input.Password" class="form-label mt-3">비밀번호</label>
        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>
        <small class="form-text">12자 이상, 대문자·소문자·숫자·기호를 포함하세요.</small>
        <label asp-for="Input.ConfirmPassword" class="form-label mt-3">비밀번호 확인</label>
        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        <button class="btn btn-primary w-100 mt-4" type="submit">가입하고 2차 인증 설정</button>
    </form>
    <p class="mt-3 mb-0"><a asp-page="/Account/Login">이미 계정이 있나요? 로그인</a></p>
</div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
